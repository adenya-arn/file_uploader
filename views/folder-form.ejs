<!DOCTYPE html>
<html>
  <head>
    <title><%= folder? "Edit Folder" : "Create Folder" %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="container">
      <div class="card form-card">
        <h1 class="page-title">
          <%= folder ? "Edit Folder" : "Create Folder" %>
        </h1>

        <form
          class="form"
          action="<%= folder ? `/folders/${folder.id}/edit` : '/folders/new' %>"
          method="POST"
        >
          <div class="form-group">
            <label> Folder Name </label>

            <input
              type="text"
              name="name"
              value="<%= folder ? folder.name : '' %>"
              required
            />
          </div>

          <button class="btn" type="submit">
            <%= folder ? "Update Folder" : "Create Folder" %>
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
