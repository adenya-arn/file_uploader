<!DOCTYPE html>
<html>
<head>
  <title>My Folders</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="container">

  <div class="page-header">

    <h1 class="page-title">
      My Folders
    </h1>

    <a
      class="btn"
      href="/folders/new"
    >
      New Folder
    </a>

  </div>

  <div class="folder-grid">

    <% folders.forEach(folder => { %>

      <div class="card folder-card">

        <h3>
          <%= folder.name %>
        </h3>

        <a
          class="btn"
          href="/folders/<%= folder.id %>"
        >
          Open
        </a>

      </div>

    <% }) %>

  </div>

</div>

</body>
</html>