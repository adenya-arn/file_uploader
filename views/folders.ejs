<!DOCTYPE html>

<html>

<head>

<title>My Folders</title>

<link rel="stylesheet" href="/styles.css">

</head>

<body>

<div class="container">

<div class="page-header">

<h1 class="page-title">

My Folders

</h1>

<a class="btn" href="/folders/new">

New Folder

</a>

</div>

<div class="folder-grid">

<% folders.forEach(folder => { %>

<div class="card folder-card">

<h3>

<%= folder.name %>

</h3>

<a class="btn" href="/folders/<%= folder.id %>">

Open

</a>

<a
  class="btn"
  href="/folders/<%= folder.id %>/edit"
>
  Edit
</a>

<form
  action="/folders/<%= folder.id %>/delete"
  method="POST"
>

  <button
    class="btn btn-danger"
    type="submit"
  >
    Delete Folder
  </button>

</form>

</div>

<% }) %>

</div>

</div>

</body>

</html>