<!DOCTYPE html>
<html>
<head>
  <title>Sign Up</title>
</head>
<body>

<div class="container">

  <div class="card form-card">

    <h1 class="page-title">
      Create Account
    </h1>

    <% if (locals.errors) { %>

      <ul class="error-list">

        <% errors.forEach(error => { %>

          <li>
            <%= error.msg %>
          </li>

        <% }) %>

      </ul>

    <% } %>

    <form
      class="form"
      action="/sign-up"
      method="POST"
    >

      <div class="form-group">

        <label>
          First Name
        </label>

        <input
          type="text"
          name="firstName"
          required
        >

      </div>

      <div class="form-group">

        <label>
          Last Name
        </label>

        <input
          type="text"
          name="lastName"
          required
        >

      </div>

      <div class="form-group">

        <label>
          Email
        </label>

        <input
          type="email"
          name="email"
          required
        >

      </div>

      <div class="form-group">

        <label>
          Password
        </label>

        <input
          type="password"
          name="password"
          required
        >

      </div>

      <div class="form-group">

        <label>
          Confirm Password
        </label>

        <input
          type="password"
          name="confirmPassword"
          required
        >

      </div>

      <button
        class="btn"
        type="submit"
      >
        Sign Up
      </button>

    </form>

  </div>

</div>

</body>
</html>